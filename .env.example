# Copiá este archivo como ".env" en local, o cargá estas mismas variables
# en el panel de "Environment Variables" de tu hosting (Render, Railway, etc.)

# API key de Anthropic (la consigues en console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# El JSON completo de la clave del service account de Google, en UNA sola linea.
# Se genera en Google Cloud Console (ver README.md, paso 2).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...":"..."}

# ID de la carpeta "Walchem" en Drive (ya lo tenemos resuelto, no hace falta cambiarlo)
WALCHEM_ROOT_FOLDER_ID=1Me1u_SbUb0YRuYJHgq0R6agpDs6RQt4n

# Opcionales (valores por defecto ya son razonables)
MAX_CHARS_PER_DOC=150000
MAX_DOCS_PER_QUERY=3
PORT=3000
